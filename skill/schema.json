{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomette.app/schema/tomette-pack-1.json",
  "title": "Fichier importable Tomette (tomette-pack v1)",
  "type": "object",
  "required": ["format", "subjects"],
  "properties": {
    "format": { "const": "tomette-pack" },
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" }, "generator": { "type": "string" }, "createdAt": { "type": "string" },
        "language": { "type": "string" }, "request": { "type": "string" }, "notes": { "type": "string" },
        "sources": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": {
          "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "type": { "enum": ["image", "pdf", "document", "text", "web", "book"] }, "url": { "type": "string", "pattern": "^https?://" }, "note": { "type": "string" } } } }
      }
    },
    "assets": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "mime": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif", "image/svg+xml"] },
      "data": { "type": "string", "description": "base64 sans préfixe (ou data:URL)" }, "file": { "type": "string", "description": "chemin dans le .zip" }, "alt": { "type": "string" } },
      "anyOf": [{ "required": ["data"] }, { "required": ["file"] }] } },
    "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subject" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$" },
    "tone": { "enum": ["accent", "success", "highlight", "info"] },
    "subject": { "type": "object", "required": ["title"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "icon": { "type": "string" }, "tone": { "$ref": "#/$defs/tone" },
      "level": { "type": "string" }, "description": { "type": "string" }, "examDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "courses": { "type": "array", "items": { "$ref": "#/$defs/course" } } } },
    "course": { "type": "object", "required": ["title"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "summary": { "type": "string" }, "order": { "type": "number" },
      "lessons": { "type": "array", "items": { "type": "object", "required": ["body"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "body": { "type": "string" }, "source": { "type": "string" }, "minutes": { "type": "number" } } } },
      "mindmaps": { "type": "array", "items": { "$ref": "#/$defs/mindmap" } },
      "diagrams": { "type": "array", "items": { "$ref": "#/$defs/diagram" } },
      "items": { "type": "array", "items": { "$ref": "#/$defs/item" } } } },
    "node": { "type": "object", "required": ["text"], "properties": {
      "id": { "type": "string" }, "text": { "type": "string" }, "icon": { "type": "string" }, "color": { "enum": ["accent", "info", "success", "highlight", "neutral"] },
      "note": { "type": "string" }, "shape": { "enum": ["note"] }, "emphasis": { "type": "boolean" }, "collapsed": { "type": "boolean" }, "weight": { "type": "number" },
      "children": { "type": "array", "items": { "$ref": "#/$defs/node" } } } },
    "mindmap": { "type": "object", "required": ["id", "root"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "layout": { "enum": ["radial", "balanced", "tree", "tree-down"] },
      "spacing": { "type": "number" }, "levelGap": { "type": "number" }, "startAngle": { "type": "number" }, "sweep": { "type": "number" },
      "edgeStyle": { "enum": ["curve", "straight", "elbow"] }, "rootShape": { "enum": ["pill", "circle"] }, "maxNodeWidth": { "type": "number" },
      "palette": { "type": "array", "items": { "enum": ["accent", "info", "success", "highlight", "neutral"] } }, "collapseDepth": { "type": "integer" },
      "root": { "$ref": "#/$defs/node" },
      "links": { "type": "array", "items": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" }, "bend": { "type": "number" } } } } } },
    "diagram": { "type": "object", "required": ["id"], "properties": {
      "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["shapes", "script"] }, "title": { "type": "string" }, "width": { "type": "number" }, "height": { "type": "number" },
      "background": { "type": "string" }, "alt": { "type": "string" },
      "shapes": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["rect", "circle", "ellipse", "line", "arrow", "polyline", "polygon", "path", "text", "label", "axes", "plot", "point", "arc", "image", "group", "grid", "brace"] } } } },
      "code": { "type": "string", "maxLength": 60000 }, "animated": { "type": "boolean" }, "interactive": { "type": "boolean" } } },
    "item": { "type": "object", "required": ["id", "type"], "properties": {
      "id": { "$ref": "#/$defs/id" },
      "type": { "enum": ["flashcard", "mcq", "truefalse", "quick", "exam", "short", "match", "order", "cloze", "label", "categorize"] },
      "source": { "type": "string" }, "explanation": { "type": "string" }, "hint": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "difficulty": { "enum": [1, 2, 3] },
      "front": { "type": "string" }, "back": { "type": "string" },
      "question": { "type": "string" }, "choices": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "correct": { "type": "boolean" }, "explanation": { "type": "string" } } } },
      "multiple": { "type": "boolean" }, "shuffle": { "type": "boolean" },
      "statement": { "type": "string" }, "answer": {}, "correction": { "type": "string" },
      "lines": { "type": "integer", "minimum": 1, "maximum": 40 }, "context": { "type": "string" }, "points": { "type": "number" }, "duration": { "type": "number" },
      "steps": { "type": "array", "items": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "points": { "type": "number" }, "detail": { "type": "string" } } } },
      "answers": { "type": "array", "items": { "type": "string" } }, "tolerance": { "type": "number" }, "unit": { "type": "string" }, "caseSensitive": { "type": "boolean" }, "accents": { "type": "boolean" },
      "prompt": { "type": "string" }, "pairs": { "type": "array", "items": { "type": "object", "required": ["left", "right"], "properties": { "left": { "type": "string" }, "right": { "type": "string" } } } },
      "items": { "type": "array", "items": { "type": "string" } }, "text": { "type": "string" }, "decoys": { "type": "array", "items": { "type": "string" } },
      "diagram": { "type": "string" }, "image": { "type": "string" },
      "zones": { "type": "array", "items": { "type": "object", "required": ["x", "y", "answer"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 100 }, "y": { "type": "number", "minimum": 0, "maximum": 100 }, "answer": { "type": "string" } } } },
      "categories": { "type": "array", "items": { "type": "object", "required": ["name", "items"], "properties": { "name": { "type": "string" }, "items": { "type": "array", "items": { "type": "string" } } } } }
    } }
  }
}
